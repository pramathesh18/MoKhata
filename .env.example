PORT=5000
NODE_ENV=production

# Your deployed frontend URL (no trailing slash)
# Example: https://mokhata-client.onrender.com
FRONTEND_URL=https://your-frontend.onrender.com

# PostgreSQL connection string from Render's database dashboard
DATABASE_URL=postgresql://user:password@host:5432/mokhata?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-string

# Generate with: npx ts-node -e "const a=require('argon2'); a.hash('your-admin-password').then(console.log)"
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=1$...replace-with-real-hash
